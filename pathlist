from __future__ import annotations

import argparse
import functools
import os
import sys
from typing import Any, Callable, Final, Generator, Iterable, TypeVar


_T = TypeVar("_T")

_DOUBLE_SLASH_CHOICES: Final = {
    "auto": "fold when the system treats `//` as the root",
    "root": "always fold a leading `//` into `/`",
    "keep": "keep a leading `//` apart from `/`",
}

def _check_fix_double_slashes () -> bool:
    try:
        return os.path.samefile("/", "//")

    except OSError:  # pragma: no cover
        # systems where either "/" or "//" is not a valid path
        return False

def _mk_argparser () -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="A small utility to handle path lists.",
        epilog="Place `INPUT` first, or end the options with `-- <INPUT>`.",
        prog=os.path.basename(__file__),
    )

    parser.add_argument(
        "inputs",
        help="Input path(s) list.",
        nargs="+",
    )

    parser.add_argument(
        "-e", "--exclude",
        help="Exclude paths from the list.",
        nargs="*",
        default=[],
    )

    parser.add_argument(
        "-s", "--separator",
        help="Default separator for the input/output path list.",
        default=":",
    )

    parser.add_argument(
        "--input-separator",
        help="Separator for the input path list. If missing, use value of --separator.",
        default=None,
    )

    parser.add_argument(
        "--output-separator",
        help="Separator for the output path list. If missing, use value of --separator.",
        default=None,
    )

    parser.add_argument(
        "--double-slashes",
        choices=tuple(_DOUBLE_SLASH_CHOICES.keys()),
        help=(
            "How to handle double slashes at the beginning of paths. Default: auto. Choices: "
            + "; ".join(f"{k!r}: {v}" for k, v in _DOUBLE_SLASH_CHOICES.items())
        ),
        default="auto",
    )

    parser.add_argument(
        "-d", "--dedup",
        help="Deduplicate the list.",
        action="store_true",
    )

    parser.add_argument(
        "--dedup-abs",
        help="Deduplicate the list by absolute paths. See --resolve-symlinks.",
        action="store_true",
    )

    parser.add_argument(
        "--abs",
        help="Convert paths to absolute. See --resolve-symlinks.",
        action="store_true",
    )

    parser.add_argument(
        "--rel",
        help="Convert paths to relative (default: the current directory). See --resolve-symlinks.",
        nargs="?",
        default=False,
        metavar="RELATIVE_TO",
    )

    parser.add_argument(
        "--resolve-symlinks",
        help="Resolve symlinks when converting paths for --abs, --rel, or --dedup-abs.",
        action="store_true",
    )

    parser.add_argument(
        "--no-remove-empty",
        help="Do not remove empty paths.",
        action="store_false",
        dest="remove_empty",
    )

    parser.add_argument(
        "--no-trim-paths",
        help="Do not trim paths.",
        action="store_false",
        dest="trim_paths",
    )

    parser.add_argument(
        "-o", "--output",
        help="Output for the path list (default: stdout).",
        default="-",
    )

    return parser

def _unique_iter (
    values: Iterable[_T], key: Callable[[_T], Any] | None = None
) -> Generator[_T, None, None]:
    seen: set[Any] = set()

    for v in values:
        k = v if (key is None) else key(v)

        if k not in seen:
            seen.add(k)
            yield v

# since we only handle str paths, we avoid pathlib.Path and use os.path instead, to also persist
# empty paths when --no-remove-empty is used
def _unchecked_normpath (p: str, fix_double_slashes: bool) -> str:
    p = os.path.normpath(p)

    if fix_double_slashes and p.startswith("//"):
        p = p[1 :]

    return p

def _normpath (p: str, fix_double_slashes: bool) -> str:
    return "" if (p == "") else _unchecked_normpath(p, fix_double_slashes)

def _unchecked_abspath (p: str, resolve_symlinks: bool, fix_double_slashes: bool) -> str:
    abs_p = os.path.abspath(p)

    # python's realpath always resolves `//<path>` to `/<path>`, so `//<path>` stays unresolved
    if resolve_symlinks and (fix_double_slashes or (not abs_p.startswith("//"))):
        abs_p = os.path.realpath(p)

    return _unchecked_normpath(abs_p, fix_double_slashes)

def _abspath (
    p: str, resolve_symlinks: bool, fix_double_slashes: bool,
    parent: str | None = None
) -> str:
    if p == "":
        return ""

    if parent is not None:
        p = os.path.join(parent, p)

    return _unchecked_abspath(p, resolve_symlinks, fix_double_slashes)

def _relpath (p: str, start: str, resolve_symlinks: bool, fix_double_slashes: bool) -> str:
    if p == "":
        return ""

    abs_p = _unchecked_abspath(p, resolve_symlinks, fix_double_slashes)

    if abs_p.startswith("//") != start.startswith("//"):
        # "//" paths cannot be made relative unless the start path is also a "//" path and
        # vice-versa for "/" paths
        return abs_p

    return os.path.relpath(abs_p, start)

if __name__ == "__main__":  # pragma: no branch
    parser = _mk_argparser()

    # two things here:
    # - we use a slice over sys.argv to tackle IndexError when no arguments are passed
    # - older Python have a bug where parse_intermixed_args() does not work when the first
    #   argument is "--", so we use parse_args() in that case (which is equivalent when "--" is
    #   the first argument)
    args = parser.parse_args() if (sys.argv[1 : 2] == ["--"]) else parser.parse_intermixed_args()

    fix_double_slashes = (
        (args.double_slashes == "root")
        or ((args.double_slashes == "auto") and _check_fix_double_slashes())
    )

    if args.rel is not False:
        if args.abs:
            parser.error("Cannot use --abs and --rel at the same time.")

        if args.rel == "":
            parser.error("The --rel option requires a non-empty argument.")

    if args.resolve_symlinks and not (args.abs or (args.rel is not False) or args.dedup_abs):
        parser.error("--resolve-symlinks requires --abs, --rel, or --dedup-abs.")

    in_sep: str = args.input_separator if (args.input_separator is not None) else args.separator

    if in_sep == "":
        parser.error("The input separator cannot be empty.")

    out_sep: str = args.output_separator if (args.output_separator is not None) else args.separator

    abspath = functools.partial(
        _abspath, resolve_symlinks=args.resolve_symlinks,
        fix_double_slashes=fix_double_slashes
    )

    relpath = functools.partial(
        _relpath, resolve_symlinks=args.resolve_symlinks,
        fix_double_slashes=fix_double_slashes
    )

    normpath = functools.partial(_normpath, fix_double_slashes=fix_double_slashes)

    inputs: Iterable[str] = args.inputs
    path_it = (p for paths in inputs for p in paths.split(in_sep))

    if args.trim_paths:
        path_it = (p.strip() for p in path_it)

    if args.remove_empty:
        path_it = (p for p in path_it if (len(p) > 0))

    exclude_it: Iterable[str] = args.exclude
    dedup_key: Callable[[str], str] | None = None

    if args.rel is not False:
        relative_to = os.getcwd() if (args.rel is None) else abspath(args.rel)

        path_it = (relpath(p, relative_to) for p in path_it)
        exclude_it = (relpath(p, relative_to) for p in exclude_it)

        if args.dedup_abs:
            # need to reconstruct the absolute path to deduplicate
            dedup_key = (lambda p: abspath(p, parent=relative_to))

    else:
        if args.abs:
            path_it = map(abspath, path_it)
            exclude_it = map(abspath, exclude_it)

        if args.dedup_abs:
            dedup_key = abspath

    if args.dedup and (dedup_key is None):
        dedup_key = normpath

    exclude_set = frozenset(map(normpath, exclude_it))

    if len(exclude_set) > 0:
        path_it = (p for p in path_it if (normpath(p) not in exclude_set))

    if dedup_key is not None:
        path_it = _unique_iter(path_it, key=dedup_key)

    out_str = out_sep.join(path_it)

    if args.output == "-":
        print(out_str, end="")

    else:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(out_str)
